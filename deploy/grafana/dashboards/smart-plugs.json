          "uid": "smart-plug-prometheus"
        },
        "query": "query_result(andlink_device_info{instance=\"smart-plugs\"})",
        "definition": "query_result(andlink_device_info{instance=\"smart-plugs\"})",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
